PORTRAIT_EVAL_DATABASE_URL=sqlite:///./workspace/portrait_eval.db
PORTRAIT_EVAL_WORKSPACE=./workspace
PORTRAIT_EVAL_API_TOKEN=
# Change this before exposing the service on a LAN. It signs read-only report URLs.
PORTRAIT_EVAL_REPORT_SHARE_SECRET=replace-with-a-long-random-secret
# JSON list when set through a config layer, for example ["/data/front-camera"]
PORTRAIT_EVAL_ALLOWED_ROOTS=[]

# OpenAI-compatible local vLLM/SGLang endpoints. Leave empty for deterministic heuristic fallback.
PORTRAIT_EVAL_PRIMARY_VLM_URL=
PORTRAIT_EVAL_PRIMARY_VLM_MODEL=Qwen/Qwen3-VL-32B-Instruct
PORTRAIT_EVAL_REVIEWER_VLM_URL=
PORTRAIT_EVAL_REVIEWER_VLM_MODEL=OpenGVLab/InternVL3_5-38B
PORTRAIT_EVAL_VLM_MAX_IMAGE_EDGE=1536
PORTRAIT_EVAL_TASK_MAX_ATTEMPTS=3

# External professional-review corroboration through a local/self-hosted SearxNG instance.
PORTRAIT_EVAL_SEARCH_PROVIDER=disabled
PORTRAIT_EVAL_SEARXNG_URL=
